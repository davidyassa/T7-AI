QMainWindow, QDialog {
    background-color: #242424;
}
QWidget {
    color: #DFDFDF;
    font-family: -apple-system, "Cantarell", "Ubuntu", "Segoe UI", sans-serif;
    font-size: 13px;
}
QFrame#card {
    background-color: #2F2F2F;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    margin: 0px;
    padding: 12px;
}
QLineEdit, QComboBox {
    background-color: #1E1E1E;
    border: 1px solid #3D3D3D;
    border-radius: 5px;
    padding: 6px 10px;
    color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3584E4;
}
QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    border: 1px solid #3D3D3D;
    selection-background-color: #3584E4;
    color: #FFFFFF;
}
QPushButton {
    background-color: #383838;
    border: 1px solid #484848;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 500;
    color: #ECECEC;
}
QPushButton:hover {
    background-color: #444444;
    border-color: #555555;
}
QPushButton:pressed {
    background-color: #2A2A2A;
}
QPushButton:disabled {
    background-color: #2A2A2A;
    color: #6E6E6E;
    border-color: #353535;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #3D3D3D;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #3584E4;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #DFDFDF;
    border: 1px solid #242424;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}
QTableWidget {
    background-color: #2A2A2A;
    border: 1px solid #3D3D3D;
    gridline-color: #383838;
    border-radius: 5px;
    color: #E0E0E0;
    selection-background-color: #3584E4;
}
QHeaderView::section {
    background-color: #1E1E1E;
    color: #A0A0A0;
    font-weight: 600;
    border: 1px solid #343434;
    padding: 5px;
}
QTabWidget::pane {
    border: 1px solid #3D3D3D;
    background-color: #2A2A2A;
    border-radius: 5px;
}
QTabBar::tab {
    background: #1E1E1E;
    color: #909090;
    padding: 7px 16px;
    font-weight: 500;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #2A2A2A;
    color: #FFFFFF;
    border-bottom: 2px solid #3584E4;
}
QStatusBar {
    background-color: #1E1E1E;
    color: #B0B0B0;
    font-size: 11px;
}